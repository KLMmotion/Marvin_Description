<?xml version="1.0"?>
<!--
  marvin_base.urdf.xacro
  Kinematic and collision description of the Marvin mobile base.

  Macro
  =====
  marvin_base(namespace)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================
       Physical constants
       ================================================================ -->
  <xacro:property name="base_mass"   value="20.0"/>   <!-- kg  -->
  <xacro:property name="base_length" value="0.60"/>   <!-- m   -->
  <xacro:property name="base_width"  value="0.45"/>   <!-- m   -->
  <xacro:property name="base_height" value="0.20"/>   <!-- m   -->

  <xacro:property name="wheel_mass"   value="1.5"/>
  <xacro:property name="wheel_radius" value="0.075"/>
  <xacro:property name="wheel_width"  value="0.050"/>
  <xacro:property name="wheel_sep"    value="0.40"/>  <!-- distance between wheel centres -->

  <xacro:property name="caster_radius" value="0.030"/>

  <!-- Convenience inertia macros -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
        iyy="${m*(x*x+z*z)/12}" iyz="0"
        izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
        iyy="${m*(3*r*r+h*h)/12}" iyz="0"
        izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${2*m*r*r/5}" ixy="0" ixz="0"
        iyy="${2*m*r*r/5}" iyz="0"
        izz="${2*m*r*r/5}"/>
    </inertial>
  </xacro:macro>

  <!-- ================================================================
       Wheel macro (left/right)
       ================================================================ -->
  <xacro:macro name="wheel" params="prefix side namespace reflect">
    <link name="${namespace}${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="dark_grey">
          <color rgba="0.2 0.2 0.2 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${namespace}${prefix}_wheel_joint" type="continuous">
      <parent link="${namespace}base_link"/>
      <child  link="${namespace}${prefix}_wheel_link"/>
      <origin xyz="0 ${reflect * wheel_sep / 2} ${wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>
  </xacro:macro>

  <!-- ================================================================
       Caster macro
       ================================================================ -->
  <xacro:macro name="caster" params="prefix x_pos namespace">
    <link name="${namespace}${prefix}_caster_link">
      <visual>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
        <material name="light_grey">
          <color rgba="0.8 0.8 0.8 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
      </collision>
      <xacro:sphere_inertia m="0.2" r="${caster_radius}"/>
    </link>

    <joint name="${namespace}${prefix}_caster_joint" type="fixed">
      <parent link="${namespace}base_link"/>
      <child  link="${namespace}${prefix}_caster_link"/>
      <origin xyz="${x_pos} 0 ${caster_radius}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <!-- ================================================================
       Main macro
       ================================================================ -->
  <xacro:macro name="marvin_base" params="namespace">

    <!-- base_footprint – zero-height projection on the ground -->
    <link name="${namespace}base_footprint"/>

    <joint name="${namespace}base_footprint_joint" type="fixed">
      <parent link="${namespace}base_footprint"/>
      <child  link="${namespace}base_link"/>
      <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>

    <!-- base_link – geometric centre of the chassis at wheel-axle height -->
    <link name="${namespace}base_link">
      <visual>
        <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${base_length} ${base_width} ${base_height}"/>
        </geometry>
        <material name="white">
          <color rgba="0.9 0.9 0.9 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${base_length} ${base_width} ${base_height}"/>
        </geometry>
      </collision>
      <xacro:box_inertia m="${base_mass}"
                         x="${base_length}"
                         y="${base_width}"
                         z="${base_height}"/>
    </link>

    <!-- Drive wheels -->
    <xacro:wheel prefix="left"  side="left"  namespace="${namespace}" reflect=" 1"/>
    <xacro:wheel prefix="right" side="right" namespace="${namespace}" reflect="-1"/>

    <!-- Passive casters -->
    <xacro:caster prefix="front" x_pos=" ${base_length/2 - caster_radius}" namespace="${namespace}"/>
    <xacro:caster prefix="rear"  x_pos="-${base_length/2 - caster_radius}" namespace="${namespace}"/>

  </xacro:macro>

</robot>
